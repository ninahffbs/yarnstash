# Copy to .env and adjust if you need to override the local defaults.
# .env is gitignored; this file is the committed reference.
#
# Every value here has a matching default in compose.yaml and
# application.properties, so the project runs with no .env at all.

# --- PostgreSQL container (compose.yaml) ---
POSTGRES_DB=yarnstash
POSTGRES_USER=yarnstash
POSTGRES_PASSWORD=yarnstash

# Host port the database is published on.
# Change this if something else already holds 5432.
POSTGRES_PORT=5432

# --- Spring Boot datasource (application.properties) ---
# Must line up with the values above.
DB_URL=jdbc:postgresql://localhost:5432/yarnstash
DB_USERNAME=yarnstash
DB_PASSWORD=yarnstash
